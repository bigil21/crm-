SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Supabase's newer setup guides may call these NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SYNC_ENABLED=true
SUPABASE_STATE_ID=coastal-crest
# SERVER ONLY: used by recovery backups and, after its migrations, the Square worker.
# Never use either key as SUPABASE_ANON_KEY / NEXT_PUBLIC_* or expose it to a browser.
# Prefer the new secret key. A legacy service_role JWT is also supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# IANA time zone used to assign each server recovery snapshot to a business day.
CRM_TIME_ZONE=America/New_York
ALLOWED_EMAIL_DOMAIN=coastalcrestroofing.com
DEFAULT_AUTH_ROLE=viewer
# Supported roles: admin, office_manager, sales_manager, operations_manager, sales, production, viewer
# Comma-separated owner/admin emails. These users get admin UI access after sign-in.
ADMIN_EMAILS=owner@coastalcrestroofing.com
AUTH_REQUIRED=true
# Production authentication fails closed. For a loopback-only demo with no cloud:
# NODE_ENV=development
# ALLOW_LOCAL_DEMO=true
# AUTH_REQUIRED=false
# SUPABASE_SYNC_ENABLED=false
# CRM_SKIP_ENV_FILES=true
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your-square-sandbox-token
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-signature-key
SQUARE_WEBHOOK_URL=https://your-domain.example/webhooks/square
SQUARE_MERCHANT_ID=your-square-merchant-id
# Enable after migrations, merchant matching and durable queue smoke tests pass.
SQUARE_PAYMENT_WORKER_ENABLED=false
# Google Workspace OAuth (server only except the public OAuth client ID).
# Create a Web application OAuth client and register this exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobcrestcrm.com/api/integrations/google/callback
# Generate separate secrets. State secret: 32+ random characters.
GOOGLE_OAUTH_STATE_SECRET=
# Exactly 32 random bytes encoded as base64 (for example: openssl rand -base64 32).
INTEGRATION_TOKEN_ENCRYPTION_KEY=
CRM_TIME_ZONE=America/New_York
# Google Drive company storage (server only). Share the selected Shared Drive
# or root folder with this service-account email before enabling automatic copies.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# Keep the PEM private key protected. Render accepts its embedded newlines.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Zoho Sign OAuth (server only). Choose the suffix matching the Zoho data center.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://jobcrestcrm.com/api/integrations/zoho/callback
ZOHO_OAUTH_STATE_SECRET=
# Examples: com, eu, in, jp, com.au, zohocloud.ca, sa, uk, sg, ae
ZOHO_DATA_CENTER=com
PORT=4173
