SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Supabase's newer setup guides may call these NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SYNC_ENABLED=true
SUPABASE_STATE_ID=coastal-crest
# SERVER ONLY: configure one worker key after installing the durable Square migrations.
# Never use either key as SUPABASE_ANON_KEY / NEXT_PUBLIC_* or expose it to a browser.
# Prefer the new secret key. A legacy service_role JWT is also supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAIL_DOMAIN=coastalcrestroofing.com
DEFAULT_AUTH_ROLE=viewer
# Supported roles: admin, office_manager, sales_manager, operations_manager, sales, production, viewer
# Comma-separated owner/admin emails. These users get admin UI access after sign-in.
ADMIN_EMAILS=owner@coastalcrestroofing.com
AUTH_REQUIRED=true
# Production authentication fails closed. For a loopback-only demo with no cloud:
# NODE_ENV=development
# ALLOW_LOCAL_DEMO=true
# AUTH_REQUIRED=false
# SUPABASE_SYNC_ENABLED=false
# CRM_SKIP_ENV_FILES=true
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your-square-sandbox-token
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-signature-key
SQUARE_WEBHOOK_URL=https://your-domain.example/webhooks/square
SQUARE_MERCHANT_ID=your-square-merchant-id
# Enable after migrations, merchant matching and durable queue smoke tests pass.
SQUARE_PAYMENT_WORKER_ENABLED=false
PORT=4173
