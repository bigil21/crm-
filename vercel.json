{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.css,*.js,manifest.webmanifest,icon.svg,icon-192.png,icon-512.png,vendor/jspdf.umd.min.js,node_modules/pdfjs-dist/build/pdf.min.mjs,node_modules/pdfjs-dist/build/pdf.worker.min.mjs}",
      "excludeFiles": "{.env,.env.*,tests/**,supabase/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
